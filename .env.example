# 키는 이 파일이 아니라 .env 에 넣는다. .env 는 gitignore 대상이다.
OPENAI_API_KEY=

# 딥리서치 · 조직 인증이 끝나면 아래를 1로 바꾼다
OPENAI_DEEP_RESEARCH_KEY=
OPENAI_DEEP_RESEARCH=0
OPENAI_DEEP_RESEARCH_MODEL=o3-deep-research

# OpenAI 이미지 호출이 실패했을 때의 예비 경로 (선택)
GEMINI_API_KEY=

# 3D 쇼룸 · 멀티뷰에서 3D 모델을 만든다
TRIPO_API_KEY=

# Miro 내보내기 (선택). 없으면 내보내기 버튼이 토큰 연결 안내를 연다
MIRO_ACCESS_TOKEN=

# 봇 벽에 막힌 스토어의 제품 사진 (선택 · 호출당 과금).
# 평범한 fetch로 이미 대부분 들어오고, 403/429로 막힌 건에만 쓴다.
# 대시보드에서 Web Unlocker zone을 만든 뒤 그 이름을 BRIGHTDATA_ZONE에 적는다.
# 비워 두면 계정의 첫 활성 zone을 쓴다.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# 컨셉 영상 · 로컬 ComfyUI (선택). 자세한 설정은 workflows/README.md
COMFY_URL=
COMFY_I2V_WORKFLOW=workflows/i2v.json
